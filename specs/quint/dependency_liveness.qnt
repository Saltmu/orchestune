// Bounded liveness of dependency resolution (#1276), abstracting the production
// harness `tests/dependency_liveness_test_support.py::LivenessWorld`.
//
// What this model is: a finite abstraction of "T is promoted when its
// dependencies hold valid completion evidence".  The simulator (`quint run`)
// samples action sequences; it is not an exhaustive proof.  Exploration is
// bounded by the topologies below (at most four dependency Issues) and by the
// sample / step counts recorded by the local CI.
//
// How it is used: every state records the promotion *obligations* of the last
// cycle (`mustNot`: no promotion allowed; `mustQueue`: promotion required,
// bound N).  The obligations are computed from the model state only.  The
// replay (tests/quint_replay.py) runs the same actions on the real cycle
// harness and compares the real observation with these obligations.
//
// Three-valued evidence ("yes" / "no" / "maybe"): where the model cannot know
// the outcome (an injected Forge fault, a lagged collection) it states no
// obligation instead of guessing.
module dependency_liveness {
  // ---- vocabulary ---------------------------------------------------------------

  // One scripted action (saved scenarios).  Fields not used by an action are
  // ignored; `a`/`d` carry strings, `n` an Issue number, `b`/`c` booleans.
  type Call = { act: str, a: str, d: str, n: int, b: bool, c: bool }

  type Scenario = {
    topo: str, recompute: bool, fault: str, guard: bool, script: List[Call]
  }

  type Topology = {
    deps: Set[int],            // dependency Issues seeded in the Forge
    required: Set[int],        // Issues T needs (empty when unresolved)
    tRequired: bool,           // false: T has an unresolved dependency
    inter: int -> Set[int],    // blocked intermediate -> the Issues it needs
    interUnresolved: Set[int]  // intermediates with an unresolved dependency
  }

  type View = { ev: int -> str, base: bool, res: Set[int] }

  // N: bound on fair cycles before promotion is required (#1219 section 4).
  pure val N = 1
  pure val T = 20

  pure val PATHS = Set("label", "record_completion", "outcome_not_needed", "prior_merge")
  pure val ISSUES = Set(11, 12, 13, 14)

  // Topologies = the range generated by `LivenessTopology` (#1265).
  pure val TOPOLOGIES: str -> Topology = Map(
    "simple_one" -> { deps: Set(11), required: Set(11), tRequired: true, inter: Map(), interUnresolved: Set() },
    "simple_two" -> { deps: Set(11, 12), required: Set(11, 12), tRequired: true, inter: Map(), interUnresolved: Set() },
    "fan_in_three" -> { deps: Set(11, 12, 13), required: Set(11, 12, 13), tRequired: true, inter: Map(), interUnresolved: Set() },
    "fan_in_four" -> { deps: Set(11, 12, 13, 14), required: Set(11, 12, 13, 14), tRequired: true, inter: Map(), interUnresolved: Set() },
    "transitive_chain" -> {
      deps: Set(11, 12, 13), required: Set(11), tRequired: true,
      inter: Map(11 -> Set(12), 12 -> Set(13)), interUnresolved: Set()
    },
    "branching_diamond" -> {
      deps: Set(11, 12, 13), required: Set(11, 12), tRequired: true,
      inter: Map(11 -> Set(13), 12 -> Set(13)), interUnresolved: Set()
    },
    "intermediate_cycle" -> {
      deps: Set(11, 12), required: Set(11), tRequired: true,
      inter: Map(11 -> Set(12), 12 -> Set(11)), interUnresolved: Set()
    },
    "dependent_cycle" -> {
      deps: Set(11), required: Set(11), tRequired: true,
      inter: Map(11 -> Set(T)), interUnresolved: Set()
    },
    "unresolved_direct" -> {
      deps: Set(11), required: Set(11), tRequired: false, inter: Map(), interUnresolved: Set()
    },
    "unresolved_transitive" -> {
      deps: Set(11), required: Set(11), tRequired: true,
      inter: Map(11 -> Set()), interUnresolved: Set(11)
    }
  )

  // ---- scenarios ----------------------------------------------------------------

  pure def doneWith(path: str, dep: int): Call = { act: "complete_dependency", a: path, d: "", n: dep, b: false, c: false }
  pure def again(dep: int): Call = { act: "duplicate_completion", a: "", d: "", n: dep, b: false, c: false }
  pure def cycleOf(apply: bool, lag: bool): Call = { act: "cycle", a: "", d: "", n: 0, b: apply, c: lag }
  pure def reboot(loss: bool): Call = { act: "restart", a: "", d: "", n: 0, b: loss, c: false }
  pure def failing(op: str, mode: str): Call = { act: "fail_next", a: op, d: mode, n: 0, b: false, c: false }
  pure def hold(kind: str, target: int): Call = { act: "toggle_hold", a: kind, d: "", n: target, b: false, c: false }
  pure def staleBy(kind: str, target: int): Call = { act: "stale_snapshot", a: kind, d: "", n: target, b: false, c: false }

  pure def scenario(topo: str, fault: str, guard: bool, script: List[Call]): Scenario =
    { topo: topo, recompute: false, fault: fault, guard: guard, script: script }

  // Saved deterministic scenarios (tests/fixtures/quint/dependency_liveness_*.json
  // refer to them by id).  A scenario fixes the topology, the model fault, the
  // known-defect guard and every action with its choices.
  pure def ok(topo: str, script: List[Call]): Scenario = scenario(topo, "none", true, script)
  pure def faulty(f: str, base: Scenario): Scenario = { ...base, fault: f }
  pure def unguarded(base: Scenario): Scenario = { ...base, guard: false }
  pure def reconciling(base: Scenario): Scenario = { ...base, recompute: true }

  pure val FINAL_APPLY = ok("simple_one", [doneWith("label", 11), cycleOf(true, false), cycleOf(true, false)])
  pure val CHAIN_APPLY = ok("transitive_chain", [
    doneWith("label", 13), cycleOf(true, false),
    doneWith("label", 12), cycleOf(true, false),
    doneWith("label", 11), cycleOf(true, false)])
  pure val DEPENDENCY_RESERVATION_APPLY = ok("simple_one", [
    doneWith("label", 11), hold("reservation", 11), cycleOf(true, false),
    hold("reservation", 11), cycleOf(true, false)])
  pure val BASE_RED_APPLY = ok("simple_one", [
    doneWith("label", 11), hold("base_red", 20), cycleOf(true, false),
    hold("base_red", 20), cycleOf(true, false)])
  pure val FINAL_DRY = ok("simple_one", [doneWith("label", 11), cycleOf(false, false), cycleOf(false, false)])
  pure val STALE_REVOKE = ok("simple_one", [
    doneWith("label", 11), staleBy("revoke", 11), cycleOf(true, false), cycleOf(true, false)])

  pure val SCENARIOS: str -> Scenario = Map(
    // ---- representative routes (safe and live on the correct model) ----
    "final_apply" -> FINAL_APPLY,
    "final_dry" -> FINAL_DRY,
    "record_dry_then_apply" -> ok("simple_one", [
      doneWith("record_completion", 11), cycleOf(false, false), cycleOf(true, false), cycleOf(false, false)]),
    "not_needed_apply" -> ok("simple_one", [doneWith("outcome_not_needed", 11), cycleOf(true, false)]),
    "prior_merge_dry" -> ok("simple_one", [doneWith("prior_merge", 11), cycleOf(false, false), cycleOf(true, false)]),
    "lagged_apply" -> ok("simple_one", [
      cycleOf(true, true), doneWith("record_completion", 11), cycleOf(true, true)]),
    "lagged_dry" -> ok("simple_one", [doneWith("label", 11), cycleOf(false, true), cycleOf(true, true)]),
    "no_op_cycles" -> ok("simple_one", [
      cycleOf(true, false), cycleOf(false, false), cycleOf(true, true), doneWith("label", 11), cycleOf(true, false)]),
    "chain_apply" -> CHAIN_APPLY,
    "chain_dry" -> ok("transitive_chain", [
      doneWith("label", 13), cycleOf(false, false), cycleOf(true, false),
      doneWith("label", 12), cycleOf(false, false), cycleOf(true, true)]),
    "diamond_apply" -> ok("branching_diamond", [
      doneWith("label", 13), cycleOf(true, false),
      doneWith("label", 11), doneWith("prior_merge", 12), cycleOf(true, false)]),
    "fan_in_four_mixed" -> ok("fan_in_four", [
      doneWith("label", 11), cycleOf(true, false),
      doneWith("record_completion", 12), cycleOf(true, false),
      doneWith("prior_merge", 13), cycleOf(false, false),
      doneWith("outcome_not_needed", 14), cycleOf(true, false), cycleOf(true, false)]),
    "dependency_reservation_apply" -> DEPENDENCY_RESERVATION_APPLY,
    "target_reservation_apply" -> ok("simple_one", [
      doneWith("label", 11), hold("reservation", 20), cycleOf(true, false),
      hold("reservation", 20), cycleOf(true, false)]),
    "dependency_reservation_dry" -> ok("simple_one", [
      doneWith("label", 11), hold("reservation", 11), cycleOf(false, false),
      hold("reservation", 11), cycleOf(false, false)]),
    "intermediate_dependency_reservation_dry" -> ok("transitive_chain", [
      doneWith("label", 13), hold("reservation", 13), cycleOf(false, false),
      hold("reservation", 13), cycleOf(false, false)]),
    "base_red_apply" -> BASE_RED_APPLY,
    "base_red_dry" -> ok("simple_one", [
      doneWith("label", 11), hold("base_red", 20), cycleOf(false, false),
      hold("base_red", 20), cycleOf(false, false)]),
    "recompute_release" -> reconciling(ok("simple_one", [
      cycleOf(true, false), doneWith("record_completion", 11), cycleOf(true, false)])),
    "failure_after_add" -> ok("simple_one", [
      doneWith("label", 11), failing("add", "after"), cycleOf(true, false), cycleOf(true, false)]),
    "failure_before_remove" -> ok("simple_one", [
      doneWith("label", 11), failing("remove", "before"), cycleOf(true, false), cycleOf(true, false)]),
    "restart_loses_ledger" -> ok("simple_one", [
      doneWith("record_completion", 11), reboot(true), cycleOf(true, false), cycleOf(true, false)]),
    "restart_keeps_ledger" -> ok("simple_one", [
      doneWith("record_completion", 11), reboot(false), cycleOf(true, false)]),
    "duplicate_completion" -> ok("simple_one", [
      doneWith("record_completion", 11), again(11), cycleOf(true, false), again(11), cycleOf(false, false)]),
    "stale_revoke" -> STALE_REVOKE,
    "stale_add_hold" -> ok("simple_one", [
      doneWith("label", 11), staleBy("add_hold", 20), cycleOf(true, false), cycleOf(true, false)]),
    "stale_add_hold_dry" -> ok("simple_one", [
      doneWith("label", 11), staleBy("add_hold", 20), cycleOf(false, false), cycleOf(false, false)]),
    "stale_complete" -> ok("simple_one", [
      staleBy("complete", 11), cycleOf(true, false), cycleOf(true, false)]),
    "stale_revoke_lagged" -> ok("simple_one", [
      doneWith("label", 11), staleBy("revoke", 11), cycleOf(true, true), cycleOf(false, true)]),
    "unresolved_direct" -> ok("unresolved_direct", [doneWith("label", 11), cycleOf(true, false), cycleOf(false, false)]),
    "unresolved_transitive" -> ok("unresolved_transitive", [cycleOf(true, false), cycleOf(false, false)]),
    "intermediate_cycle" -> ok("intermediate_cycle", [cycleOf(true, false), cycleOf(false, false)]),
    "dependent_cycle" -> ok("dependent_cycle", [cycleOf(true, false), cycleOf(false, false)]),

    // ---- the model faults (the correct model passes the scripts above) ----
    "fault_suppress" -> faulty("suppress", FINAL_APPLY),
    "fault_delay" -> faulty("delay", FINAL_APPLY),
    "fault_stale_evidence" -> faulty("stale_evidence", STALE_REVOKE),
    "fault_ignore_intermediate" -> faulty("ignore_intermediate", CHAIN_APPLY),
    "fault_bypass_reservation" -> faulty("bypass_reservation", DEPENDENCY_RESERVATION_APPLY),
    "fault_bypass_hold" -> faulty("bypass_hold", BASE_RED_APPLY),
    "fault_event_only" -> faulty("event_only", FINAL_APPLY),
    "fault_dry_run_writes" -> faulty("dry_run_writes", FINAL_DRY),

    // ---- production counterexamples (guard off: the model states the obligation
    //      that production violates; the replay pins each to its Issue) ----
    "defect_target_own_reservation_dry" -> unguarded(ok("simple_one", [
      doneWith("label", 11), hold("reservation", 20), cycleOf(false, false)])),
    "defect_intermediate_own_reservation_dry" -> unguarded(ok("transitive_chain", [
      hold("reservation", 12), doneWith("label", 13), cycleOf(false, false)])),
    "defect_prior_merge_after_faults" -> unguarded(ok("simple_two", [
      doneWith("label", 11), doneWith("prior_merge", 12),
      failing("add", "after"), cycleOf(true, false),
      failing("remove", "after"), cycleOf(true, true),
      cycleOf(false, false)]))
  )


  // ---- three-valued logic -------------------------------------------------------

  pure def and3(a: str, b: str): str =
    if (a == "no" or b == "no") "no" else if (a == "maybe" or b == "maybe") "maybe" else "yes"

  // Evidence states: none | label | prior | prior_tainted | pending |
  // pending_maybe | collected | lost | uncertain.
  // valid: usable by an apply cycle.  visible: usable by a dry run (the dry run
  // never collects ledger evidence, #882).
  pure def validOf(e: str): str =
    if (Set("label", "prior", "prior_tainted", "pending", "collected").contains(e)) "yes"
    else if (Set("pending_maybe", "uncertain").contains(e)) "maybe"
    else "no"

  pure def visibleOf(e: str): str =
    if (Set("label", "prior", "collected").contains(e)) "yes"
    else if (Set("prior_tainted", "pending_maybe", "uncertain").contains(e)) "maybe"
    else "no"

  pure def evidenceOf(ev: int -> str, n: int): str =
    if (ev.keys().contains(n)) ev.get(n) else "none"

  pure def allEvidence(ev: int -> str, needs: Set[int], apply: bool): str =
    needs.fold("yes", (acc, n) =>
      and3(acc, if (apply) validOf(evidenceOf(ev, n)) else visibleOf(evidenceOf(ev, n))))

  // Promotion decision of `n` (T or an intermediate) in view `v`:
  // "yes" every need is satisfied and nothing holds it back, "no" it is held
  // back or a need is certainly unsatisfied, "maybe" otherwise.  `own`: count
  // the node's own completion reservation.
  pure def decide(tp: Topology, v: View, apply: bool, n: int, own: bool): str = {
    val needs = if (n == T) tp.required else tp.inter.get(n)
    val unresolved = if (n == T) not(tp.tRequired) else tp.interUnresolved.contains(n)
    val held = needs.intersect(v.res).size() > 0
      or (own and v.res.contains(n))
      or (n == T and v.base)
    if (unresolved or held) "no" else allEvidence(v.ev, needs, apply)
  }

  pure def subjects(tp: Topology): Set[int] = tp.inter.keys().union(Set(T))

  // ---- state --------------------------------------------------------------------

  var topo: str
  var shape: Topology             // the topology's shape (the replay builds the production graph from it)
  var lab: int -> str          // blocked | queued | final | inprogress | unknown
  var ev: int -> str           // evidence per dependency Issue
  var base: bool               // T carries the base-branch-red hold
  var recompute: bool          // T carries the recompute label
  var res: Set[int]            // unreleased completion reservations
  var armed: { op: str, mode: str }  // armed Forge fault ("none": nothing armed)
  var stale: { kind: str, target: int }  // change between context build and promotion
  var staleApplied: str        // the stale change the last cycle really applied ("none" otherwise)
  var streak: int -> int       // fair cycles in a row (per subject)
  var lastMode: str            // "apply" | "dry" | "none"
  var fault: str               // injected model fault ("none": the correct model)
  var guard: bool              // exclude the production counterexamples #1281 / #1283
  var sid: str                 // scripted scenario id ("": random exploration)
  var pc: int                  // next script position
  var planned: int             // script length (0: random exploration); a scripted run must end at pc == planned
  // Observation of the last step; cleared by every non-cycle step so a past
  // preview can never satisfy a later cycle.
  var wasCycle: bool
  var applied: bool
  var events: Set[int]         // promotion events (apply: real; dry run: preview)
  var newlyQueued: Set[int]    // nodes whose label really became queued
  var mustNot: Set[int]        // nodes that must not be promoted in the last cycle
  var mustQueue: Set[int]      // nodes that must be queued / previewed

  // ---- scripts ------------------------------------------------------------------

  pure def scripted(s: str): bool = s != ""

  pure def pick(dom: Set[a], isScripted: bool, v: a): Set[a] =
    if (isScripted) dom.filter(x => x == v) else dom

  pure val IDLE: Call = { act: "", a: "", d: "", n: 0, b: false, c: false }

  val call: Call =
    if (scripted(sid) and pc < length(SCENARIOS.get(sid).script)) SCENARIOS.get(sid).script[pc]
    else IDLE

  // An action may run when the model is random, or when the script says so.
  def turn(name: str): bool =
    not(scripted(sid)) or call.act == name

  action advance: bool = pc' = pc + 1

  // Observation cleared by every step that is not a cycle.
  action quiet: bool = all {
    wasCycle' = false, applied' = false, events' = Set(), newlyQueued' = Set(),
    mustNot' = Set(), mustQueue' = Set()
  }

  action settled: bool = all {
    topo' = topo, shape' = shape, fault' = fault, guard' = guard, sid' = sid,
    lastMode' = lastMode, streak' = streak, staleApplied' = "none", planned' = planned
  }

  // ---- init ---------------------------------------------------------------------

  action start(kind: str, withRecompute: bool, f: str, g: bool, id: str): bool = {
    val tp0 = TOPOLOGIES.get(kind)
    all {
      topo' = kind,
      shape' = tp0,
      staleApplied' = "none",
      recompute' = withRecompute,
      lab' = tp0.deps.union(Set(T)).mapBy(n =>
        if (n == T or tp0.inter.keys().contains(n)) "blocked" else "queued"),
      ev' = tp0.deps.mapBy(n => "none"),
      base' = false,
      res' = Set(),
      armed' = { op: "none", mode: "none" },
      stale' = { kind: "none", target: 0 },
      streak' = tp0.deps.union(Set(T)).mapBy(n => 0),
      lastMode' = "none",
      fault' = f,
      guard' = g,
      sid' = id,
      pc' = 0,
      planned' = if (scripted(id)) length(SCENARIOS.get(id).script) else 0,
      wasCycle' = false, applied' = false, events' = Set(), newlyQueued' = Set(),
      mustNot' = Set(), mustQueue' = Set()
    }
  }

  action init: bool = {
    nondet kind = TOPOLOGIES.keys().oneOf()
    nondet withRecompute = Set(true, false).oneOf()
    start(kind, withRecompute, "none", true, "")
  }

  action initScenario(id: str): bool = {
    val s = SCENARIOS.get(id)
    start(s.topo, s.recompute, s.fault, s.guard, id)
  }

  // ---- the eight actions (one per production harness rule) ----------------------

  // Evidence for a dependency Issue: only a queued Issue without evidence.
  def completable: Set[int] =
    TOPOLOGIES.get(topo).deps.filter(n => evidenceOf(ev, n) == "none" and lab.get(n) == "queued")

  action complete_dependency: bool = {
    nondet path = pick(PATHS, scripted(sid), call.a).oneOf()
    nondet dep = pick(completable, scripted(sid), call.n).oneOf()
    all {
      turn("complete_dependency"),
      ev' = ev.set(dep, if (path == "label") "label"
                        else if (path == "prior_merge") "prior"
                        else "pending"),
      lab' = lab.set(dep, if (path == "label") "final"
                          else if (path == "prior_merge") lab.get(dep)
                          else "inprogress"),
      base' = base, recompute' = recompute, res' = res, armed' = armed, stale' = stale,
      settled, quiet, advance
    }
  }

  action duplicate_completion: bool = {
    nondet dep = pick(TOPOLOGIES.get(topo).deps.filter(n => evidenceOf(ev, n) != "none"),
                      scripted(sid), call.n).oneOf()
    all {
      turn("duplicate_completion"),
      ev' = ev, lab' = lab, base' = base, recompute' = recompute, res' = res,
      armed' = armed, stale' = stale, settled, quiet, advance
    }
  }

  action restart: bool = {
    nondet ledgerLoss = pick(Set(true, false), scripted(sid), call.b).oneOf()
    all {
      turn("restart"),
      res' = if (ledgerLoss) Set() else res,
      ev' = if (ledgerLoss)
        ev.keys().mapBy(n =>
          if (ev.get(n) == "pending") "lost"
          else if (ev.get(n) == "pending_maybe") "uncertain"
          else ev.get(n))
        else ev,
      lab' = lab, base' = base, recompute' = recompute, armed' = armed, stale' = stale,
      settled, quiet, advance
    }
  }

  action fail_next: bool = {
    nondet op = pick(Set("add", "remove"), scripted(sid), call.a).oneOf()
    nondet mode = pick(Set("before", "after"), scripted(sid), call.d).oneOf()
    all {
      turn("fail_next"),
      armed' = { op: op, mode: mode },
      ev' = ev, lab' = lab, base' = base, recompute' = recompute, res' = res,
      stale' = stale, settled, quiet, advance
    }
  }

  // base_red / recompute act on T; a reservation can sit on T or any dependency.
  action toggle_hold: bool = {
    nondet kind = pick(Set("base_red", "recompute", "reservation"), scripted(sid), call.a).oneOf()
    nondet target = pick(
      if (kind == "reservation") TOPOLOGIES.get(topo).deps.union(Set(T)) else Set(T),
      scripted(sid), call.n).oneOf()
    all {
      turn("toggle_hold"),
      base' = if (kind == "base_red") not(base) else base,
      recompute' = if (kind == "recompute") not(recompute) else recompute,
      res' = if (kind != "reservation") res
             else if (res.contains(target)) res.exclude(Set(target)) else res.union(Set(target)),
      ev' = ev, lab' = lab, armed' = armed, stale' = stale, settled, quiet, advance
    }
  }

  // The change happens in the next cycle, after the context was built and before
  // promotion.  add_hold: T gets the base-red hold; revoke: a label evidence is
  // withdrawn (a leaf dependency only, so no queued node loses its premise);
  // complete: a queued dependency gets label evidence.
  def staleTargets(kind: str): Set[int] = {
    val tp = TOPOLOGIES.get(topo)
    val needed = tp.inter.keys().fold(Set(), (acc, n) => acc.union(tp.inter.get(n)))
    if (kind == "add_hold") Set(T)
    else if (kind == "revoke") tp.deps.filter(n => evidenceOf(ev, n) == "label" and not(needed.contains(n)))
    else completable
  }

  action stale_snapshot: bool = {
    nondet kind = pick(Set("add_hold", "revoke", "complete"), scripted(sid), call.a).oneOf()
    nondet target = pick(staleTargets(kind), scripted(sid), call.n).oneOf()
    all {
      turn("stale_snapshot"),
      stale' = { kind: kind, target: target },
      ev' = ev, lab' = lab, base' = base, recompute' = recompute, res' = res,
      armed' = armed, settled, quiet, advance
    }
  }

  // ---- the cycle ----------------------------------------------------------------

  def view0: View = { ev: ev, base: base, res: res }

  // The stale change as the real harness would apply it (a change whose premise
  // vanished in the meantime is a no-op).
  def staleEffective: bool =
    (stale.kind == "add_hold")
    or (stale.kind == "revoke" and evidenceOf(ev, stale.target) == "label")
    or (stale.kind == "complete" and completable.contains(stale.target))

  def view1: View =
    if (not(staleEffective)) view0
    else if (stale.kind == "add_hold") { ...view0, base: true }
    else if (stale.kind == "revoke") { ...view0, ev: ev.set(stale.target, "none") }
    else { ...view0, ev: ev.set(stale.target, "label") }

  // The view that decides whether `n` may be promoted.
  def judged(n: int, apply: bool, lag: bool): View =
    if (n == T) (if (apply) (if (lag) { ...view0, base: view1.base } else view1) else view0)
    else (if (not(apply) or lag) view0 else view1)

  // A fault armed for an apply cycle may or may not hit; the model then states
  // no liveness obligation and forgets what the fault might have touched.
  def armedHit(apply: bool): bool = apply and armed.op != "none"

  // Known production counterexamples (#1283 / #1281): while `guard` is set the
  // model states no obligation for them.
  def selfReservationExcused(n: int, apply: bool, lag: bool): bool =
    guard and not(apply) and view0.res.contains(n)
      and decide(TOPOLOGIES.get(topo), judged(n, apply, lag), apply, n, false) != "no"

  def mustNotOf(n: int, apply: bool, lag: bool): bool =
    decide(TOPOLOGIES.get(topo), judged(n, apply, lag), apply, n, true) == "no"
      and not(selfReservationExcused(n, apply, lag))

  def fairOf(n: int, apply: bool): bool =
    not(armedHit(apply))
      and decide(TOPOLOGIES.get(topo), view0, apply, n, true) == "yes"
      and decide(TOPOLOGIES.get(topo), view1, apply, n, true) == "yes"
      and (n == T or lab.get(n) == "blocked")

  def streakOf(n: int, apply: bool): int =
    if (not(fairOf(n, apply))) 0
    else if (lastMode == (if (apply) "apply" else "dry")) streak.get(n) + 1
    else 1

  // Nodes the (possibly faulty) system promotes in this cycle.
  def promotedBy(apply: bool, lag: bool): Set[int] = {
    val tp = TOPOLOGIES.get(topo)
    val every = subjects(tp)
    val required = every.filter(n => streakOf(n, apply) >= N)
    val promoted =
      if (fault == "suppress") Set()
      else if (fault == "delay") every.filter(n => streakOf(n, apply) >= N + 1)
      else if (fault == "ignore_intermediate") required.filter(n => n == T)
      else if (fault == "stale_evidence")
        required.union(every.filter(n => decide(tp, view0, apply, n, true) == "yes"))
      else if (fault == "bypass_hold")
        required.union(every.filter(n =>
          decide(tp, { ...judged(n, apply, lag), base: false }, apply, n, true) == "yes"))
      else if (fault == "bypass_reservation")
        required.union(every.filter(n =>
          decide(tp, { ...judged(n, apply, lag), res: Set() }, apply, n, true) == "yes"))
      else required
    promoted.filter(n => lab.get(n) != "queued")
  }

  // Ledger evidence is collected by an apply cycle that nothing disturbs.
  def collected(n: int, apply: bool, lag: bool): str = {
    val e = evidenceOf(ev, n)
    val settledCycle = apply and armed.op == "none" and not(lag) and not(res.contains(n))
    if (e != "pending" and e != "pending_maybe") e
    else if (not(apply)) e
    else if (settledCycle) "collected"
    else "pending_maybe"
  }

  def afterCycleEvidence(apply: bool, lag: bool): int -> str = {
    val stale1 = view1.ev
    stale1.keys().mapBy(n => {
      val e = collected(n, apply, lag)
      // Evidence in view1 differs from ev only by the stale change.
      val e1 = if (stale1.get(n) != ev.get(n)) stale1.get(n) else e
      // A prior-merge preview after a faulted apply cycle is the #1281 counterexample.
      if (guard and apply and armed.op != "none" and e1 == "prior") "prior_tainted" else e1
    })
  }

  def afterCycleLabels(apply: bool, lag: bool): int -> str = {
    val tp = TOPOLOGIES.get(topo)
    val every = subjects(tp)
    val promoted = promotedBy(apply, lag)
    lab.keys().mapBy(n => {
      val l = lab.get(n)
      val stale1 = view1.ev
      if (every.contains(n)) {
        if (apply and fault != "event_only" and promoted.contains(n)) "queued"
        else if (not(apply) and fault == "dry_run_writes" and promoted.contains(n)) "queued"
        else if (apply and (armedHit(apply)) and l != "final") "unknown"
        else if (apply and l == "blocked" and not(mustNotOf(n, apply, lag))
                 and streakOf(n, apply) < N) "unknown"
        else l
      } else if (stale.kind == "revoke" and staleEffective and n == stale.target) "queued"
      else if (stale.kind == "complete" and staleEffective and n == stale.target) "final"
      else if (collected(n, apply, lag) == "collected" and ev.get(n) != "collected") "final"
      else l
    })
  }

  action cycle: bool = {
    nondet apply = pick(Set(true, false), scripted(sid), call.b).oneOf()
    nondet lag = pick(Set(true, false), scripted(sid), call.c).oneOf()
    val tp = TOPOLOGIES.get(topo)
    val every = subjects(tp)
    val promoted = promotedBy(apply, lag)
    all {
      turn("cycle"),
      // Not modeled: an injected fault can abort an apply cycle before the stale
      // change happens, so the model cannot say whether it was applied.
      not(apply and armed.op != "none" and stale.kind != "none"),
      wasCycle' = true,
      applied' = apply,
      events' = promoted,
      newlyQueued' = if ((apply and fault != "event_only")
                         or (not(apply) and fault == "dry_run_writes")) promoted else Set(),
      mustNot' = every.filter(n => mustNotOf(n, apply, lag)),
      mustQueue' = every.filter(n => streakOf(n, apply) >= N),
      streak' = every.union(streak.keys()).mapBy(n =>
        if (every.contains(n)) streakOf(n, apply) else 0),
      lastMode' = if (apply) "apply" else "dry",
      ev' = afterCycleEvidence(apply, lag),
      lab' = afterCycleLabels(apply, lag),
      base' = view1.base,
      recompute' = recompute,
      res' = res,
      armed' = { op: "none", mode: "none" },
      stale' = { kind: "none", target: 0 },
      topo' = topo, shape' = shape, fault' = fault, guard' = guard, sid' = sid,
      staleApplied' = if (staleEffective) stale.kind else "none",
      planned' = planned,
      advance
    }
  }

  action step: bool = any {
    complete_dependency,
    duplicate_completion,
    cycle,
    restart,
    fail_next,
    toggle_hold,
    stale_snapshot
  }

  // ---- properties ---------------------------------------------------------------

  // Safety: nothing is promoted (event or real label) against an obligation.
  val safety: bool = events.union(newlyQueued).intersect(mustNot).size() == 0

  // Bounded liveness: every node whose fair-cycle streak reached N is queued
  // (apply: the real label) or shows this cycle's preview (dry run).
  val liveness: bool = mustQueue.forall(n =>
    lab.get(n) == "queued" or (not(applied) and events.contains(n)))

  // Every event of an apply cycle is a real label change (no event-only success).
  // The converse is deliberately not claimed: production can promote an
  // intermediate node without a PromotionEvent under listing lag (#1296).
  val eventsAreLabelChanges: bool = not(applied) or events.subseteq(newlyQueued)

  // A dry run never changes a label to queued by itself.
  val dryRunReadOnly: bool = applied or newlyQueued.size() == 0

  val allProperties: bool = safety and liveness and eventsAreLabelChanges and dryRunReadOnly

  // Witnesses: the exploration is only meaningful if these are reached.
  val reachedApplyPromotion: bool = applied and newlyQueued.contains(T)
  val reachedDryRunPreview: bool = wasCycle and not(applied) and events.contains(T)
  val reachedIntermediatePromotion: bool = events.exists(n => n != T)
  val reachedForbiddenPromotion: bool = mustNot.size() > 0
  val reachedLiveness: bool = mustQueue.size() > 0
  val reachedHoldCycle: bool = wasCycle and (base or res.size() > 0)

  // One entry point per saved scenario (`quint run --init=init_<id>`).
  action init_final_apply: bool = initScenario("final_apply")
  action init_final_dry: bool = initScenario("final_dry")
  action init_record_dry_then_apply: bool = initScenario("record_dry_then_apply")
  action init_not_needed_apply: bool = initScenario("not_needed_apply")
  action init_prior_merge_dry: bool = initScenario("prior_merge_dry")
  action init_lagged_apply: bool = initScenario("lagged_apply")
  action init_lagged_dry: bool = initScenario("lagged_dry")
  action init_no_op_cycles: bool = initScenario("no_op_cycles")
  action init_chain_apply: bool = initScenario("chain_apply")
  action init_chain_dry: bool = initScenario("chain_dry")
  action init_diamond_apply: bool = initScenario("diamond_apply")
  action init_fan_in_four_mixed: bool = initScenario("fan_in_four_mixed")
  action init_dependency_reservation_apply: bool = initScenario("dependency_reservation_apply")
  action init_target_reservation_apply: bool = initScenario("target_reservation_apply")
  action init_dependency_reservation_dry: bool = initScenario("dependency_reservation_dry")
  action init_intermediate_dependency_reservation_dry: bool = initScenario("intermediate_dependency_reservation_dry")
  action init_base_red_apply: bool = initScenario("base_red_apply")
  action init_base_red_dry: bool = initScenario("base_red_dry")
  action init_recompute_release: bool = initScenario("recompute_release")
  action init_failure_after_add: bool = initScenario("failure_after_add")
  action init_failure_before_remove: bool = initScenario("failure_before_remove")
  action init_restart_loses_ledger: bool = initScenario("restart_loses_ledger")
  action init_restart_keeps_ledger: bool = initScenario("restart_keeps_ledger")
  action init_duplicate_completion: bool = initScenario("duplicate_completion")
  action init_stale_revoke: bool = initScenario("stale_revoke")
  action init_stale_add_hold: bool = initScenario("stale_add_hold")
  action init_stale_add_hold_dry: bool = initScenario("stale_add_hold_dry")
  action init_stale_complete: bool = initScenario("stale_complete")
  action init_stale_revoke_lagged: bool = initScenario("stale_revoke_lagged")
  action init_unresolved_direct: bool = initScenario("unresolved_direct")
  action init_unresolved_transitive: bool = initScenario("unresolved_transitive")
  action init_intermediate_cycle: bool = initScenario("intermediate_cycle")
  action init_dependent_cycle: bool = initScenario("dependent_cycle")
  action init_fault_suppress: bool = initScenario("fault_suppress")
  action init_fault_delay: bool = initScenario("fault_delay")
  action init_fault_stale_evidence: bool = initScenario("fault_stale_evidence")
  action init_fault_ignore_intermediate: bool = initScenario("fault_ignore_intermediate")
  action init_fault_bypass_reservation: bool = initScenario("fault_bypass_reservation")
  action init_fault_bypass_hold: bool = initScenario("fault_bypass_hold")
  action init_fault_event_only: bool = initScenario("fault_event_only")
  action init_fault_dry_run_writes: bool = initScenario("fault_dry_run_writes")
  action init_defect_target_own_reservation_dry: bool = initScenario("defect_target_own_reservation_dry")
  action init_defect_intermediate_own_reservation_dry: bool = initScenario("defect_intermediate_own_reservation_dry")
  action init_defect_prior_merge_after_faults: bool = initScenario("defect_prior_merge_after_faults")
}
